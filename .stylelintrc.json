{
  "customSyntax": "postcss-scss",
  "rules": {
    "declaration-property-value-allowed-list": {
      "font-size": [
        "/^\\$text-/",
        "/^clamp\\(/",
        "inherit",
        "1em"
      ],
      "letter-spacing": [
        "/^\\$tracking-/",
        "normal",
        "inherit"
      ],
      "font-weight": [
        "/^\\$font-weight-/",
        "inherit",
        "normal"
      ]
    }
  },
  "ignoreFiles": [
    "node_modules/**",
    "dist/**"
  ],
  "overrides": [
    {
      "files": ["src/styles/_variables.scss"],
      "rules": {
        "declaration-property-value-allowed-list": null
      }
    }
  ]
}
